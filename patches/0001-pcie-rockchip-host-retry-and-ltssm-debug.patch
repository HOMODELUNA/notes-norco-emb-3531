From: EMB-3531 项目组
Subject: [PATCH 1/2] pcie: rockchip-host: 链路训练重试与 LTSSM 调试输出

本补丁在 rockchip_pcie_host_init_port() 中加入两处改动。

1. 链路训练失败后重试 4 次，做法参考 Armbian build PR 4308。
   部分 RK3399 板卡的 PCIe 链路不稳定，重启训练常能成功。
2. 超时信息改为输出 PCIE_CLIENT_BASIC_STATUS1 的原始值、链路状态位
   与尝试次数，并额外输出 PCIE_CLIENT_DEBUG_OUT_0（含 LTSSM 状态）、
   PCIE_CLIENT_BASIC_STATUS0、PCIE_CLIENT_SIDE_BAND_STATUS。

实测结果：EMB-3531 上 5 次尝试全部停在 LTSSM Detect.Active。
该补丁对故障卡无效，但调试输出对后续排查有用。

适用范围：linux-6.18.24。
---
--- a/drivers/pci/controller/pcie-rockchip-host.c
+++ b/drivers/pci/controller/pcie-rockchip-host.c
@@ -283,9 +283,10 @@
 static int rockchip_pcie_host_init_port(struct rockchip_pcie *rockchip)
 {
 	struct device *dev = rockchip->dev;
-	int err, i = MAX_LANE_NUM;
+	int err, i = MAX_LANE_NUM, attempt = 0;
 	u32 status;
 
+retry_link_training:
 	gpiod_set_value_cansleep(rockchip->perst_gpio, 0);
 
 	err = rockchip_pcie_init_port(rockchip);
@@ -324,7 +325,14 @@
 				 status, PCIE_LINK_UP(status), 20,
 				 500 * USEC_PER_MSEC);
 	if (err) {
-		dev_err(dev, "PCIe link training gen1 timeout!\n");
+		dev_err(dev, "PCIe link training gen1 timeout! status=0x%08x attempt=%d\n",
+			status, attempt + 1);
+		dev_err(dev, "PCIe debug: ltssm=0x%02x dbg0=0x%08x st0=0x%08x sideband=0x%08x\n",
+			rockchip_pcie_read(rockchip, PCIE_CLIENT_DEBUG_OUT_0) &
+				PCIE_CLIENT_DEBUG_LTSSM_MASK,
+			rockchip_pcie_read(rockchip, PCIE_CLIENT_DEBUG_OUT_0),
+			rockchip_pcie_read(rockchip, PCIE_CLIENT_BASIC_STATUS0),
+			rockchip_pcie_read(rockchip, PCIE_CLIENT_SIDE_BAND_STATUS));
 		goto err_power_off_phy;
 	}
 
@@ -393,6 +401,16 @@
 	i = MAX_LANE_NUM;
 	while (i--)
 		phy_exit(rockchip->phys[i]);
+
+	/*
+	 * 部分 RK3399 板卡的 PCIe 链路不稳定，重启训练常能成功。
+	 * 参考 Armbian build PR 4308（attempt counter for buggy PCIe links）。
+	 */
+	if (++attempt < 5) {
+		dev_info(dev, "retry PCIe link training (%d/4)\n", attempt);
+		i = MAX_LANE_NUM;
+		goto retry_link_training;
+	}
 	return err;
 }
 
